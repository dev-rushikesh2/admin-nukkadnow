# ==============================================================================
# NUKKADNOW SUPER-ADMIN CONSOLE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# As an Angular client-side application, all variables defined here are bundled into
# public browser distribution artifacts.
# NEVER PUT PRIVATE KEYS, JWT SECRETS, DATABASE STRINGS, OR PAYMENT SECRETS HERE!
# ==============================================================================

# Node / Environment indicator
NODE_ENV=development

# Administrative API Gateway Endpoint (Restricted ingress)
NG_APP_ADMIN_API_BASE_URL=http://localhost:3000/api/v1/admin

# Realtime WebSocket / SSE Admin Event Ingress
NG_APP_ADMIN_WS_URL=ws://localhost:3000/api/v1/admin/realtime

# Authentication & Session Security Policy
NG_APP_SESSION_IDLE_TIMEOUT_MINUTES=15
NG_APP_STEP_UP_TOKEN_TTL_SECONDS=300
NG_APP_MFA_CHALLENGE_TIMEOUT_SECONDS=180

# Environment Tier (local | staging | production)
NG_APP_ENV_NAME=local

# Telemetry & Error Tracking (Public DSN)
NG_APP_SENTRY_DSN=

# Pilot Locality Default (Nagpur, Maharashtra)
NG_APP_DEFAULT_LOCALITY=Nagpur
NG_APP_DEFAULT_LAT=21.1458
NG_APP_DEFAULT_LNG=79.0882
