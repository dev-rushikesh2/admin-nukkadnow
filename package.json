{
  "name": "nukkadnow-admin",
  "version": "1.0.0",
  "private": true,
  "description": "NukkadNow Super-Admin & Platform Operations Portal - Restrictive Hyperlocal Marketplace Management",
  "author": "NukkadNow Platform Engineering",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "ng serve --port 4202",
    "start": "ng serve --port 4202",
    "build": "turbo run build",
    "build:prod": "ng build --configuration production",
    "build:staging": "ng build --configuration staging",
    "test": "turbo run test",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:coverage": "ng test --watch=false --code-coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "turbo run lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md,yml,yaml}\"",
    "generate:api": "node tools/generate-admin-client.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:security": "node tools/verify-security-headers.mjs",
    "clean": "turbo run clean && rimraf dist .angular"
  },
  "dependencies": {
    "@angular/animations": "^18.2.11",
    "@angular/cdk": "^18.2.11",
    "@angular/common": "^18.2.11",
    "@angular/compiler": "^18.2.11",
    "@angular/core": "^18.2.11",
    "@angular/forms": "^18.2.11",
    "@angular/platform-browser": "^18.2.11",
    "@angular/platform-browser-dynamic": "^18.2.11",
    "@angular/router": "^18.2.11",
    "lucide-angular": "^0.454.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.11",
    "@angular/cli": "^18.2.11",
    "@angular/compiler-cli": "^18.2.11",
    "@angular-eslint/builder": "^18.4.1",
    "@angular-eslint/eslint-plugin": "^18.4.1",
    "@angular-eslint/eslint-plugin-template": "^18.4.1",
    "@angular-eslint/schematics": "^18.4.1",
    "@angular-eslint/template-parser": "^18.4.1",
    "@playwright/test": "^1.48.2",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.2.3",
    "typescript": "~5.5.4"
  }
}
